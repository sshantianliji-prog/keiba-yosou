{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keiba-yosou",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "keiba-yosou", "database_id": "b89e5162-f8c9-4545-8885-d8c11dea8660" }
  ],
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "12c695b41b3d437f89b4447390f733a0" }
  ],
  "observability": { "enabled": true }
}
